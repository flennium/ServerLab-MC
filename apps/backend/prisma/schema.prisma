// Prisma schema for ServerLab MC local app data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id          String   @id @default(uuid())
  name        String
  path        String
  version     String
  software    String   // paper | purpur | folia | spigot | fabric | vanilla | velocity | waterfall | bungeecord
  kind        String   @default("server")
  softwareBuildId String?
  targetMinecraftVersion String?
  bindAddress String   @default("0.0.0.0")
  configurationState String @default("ready")
  javaRequirementMajor Int?
  javaRequirementConfidence String?
  javaRequirementMethod String?
  javaRequirementDetails String?
  javaRequirementDetectedAt DateTime?
  javaPath    String
  javaRuntimeId String?
  javaOverrideMode String @default("automatic")
  allowUnsupportedJava Boolean @default(false)
  ramMinMb    Int      @default(1024)
  ramMaxMb    Int      @default(4096)
  port        Int      @default(25565)
  startupArgs String?
  autoStart   Boolean  @default(false)
  status      String   @default("stopped") // stopped|starting|running|stopping|crashed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  backups     Backup[]
  plugins     Plugin[]
  pluginJobs  PluginInstallJob[]
  javaRuntime JavaRuntime? @relation(fields: [javaRuntimeId], references: [id], onDelete: SetNull)

  @@map("servers")
}

model Template {
  id            String    @id @default(uuid())
  name          String
  repositoryUrl String
  version       String?
  author        String?
  official      Boolean   @default(false)
  installedAt   DateTime?

  @@map("templates")
}

model Backup {
  id        String   @id @default(uuid())
  serverId  String
  location  String
  sizeBytes Int
  type      String   @default("manual") // manual | scheduled
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("backups")
}

model JavaVersion {
  id       String  @id @default(uuid())
  major    Int
  path     String
  vendor   String? // adoptium | manual
  detected Boolean @default(true)

  @@map("java_versions")
}

model JavaRuntime {
  id                String   @id @default(uuid())
  provider          String?
  distribution      String
  major             Int
  version           String
  os                String
  arch              String
  source            String
  path              String
  executablePath    String
  status            String   @default("valid")
  checksum          String?
  detectedAt        DateTime?
  installedAt       DateTime?
  lastValidatedAt   DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers           Server[]

  @@unique([executablePath])
  @@map("java_runtimes")
}

model JavaInstallJob {
  id                String   @id
  provider          String
  major             Int
  version           String?
  status            String   @default("queued")
  stage             String   @default("resolving-provider")
  bytesReceived     Int      @default(0)
  totalBytes        Int?
  speedBytesPerSec  Int      @default(0)
  etaSeconds        Int?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("java_install_jobs")
}

model SoftwareArtifact {
  id               String   @id @default(uuid())
  provider         String
  minecraftVersion String
  buildId          String
  acquisition      String   @default("download")
  buildTool        String?
  buildToolVersion  String?
  sourceMetadataJson String?
  buildLogPath      String?
  filename         String
  sizeBytes        Int      @default(0)
  sha256           String?
  cachedPath       String
  status           String   @default("cached")
  downloadedAt     DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, minecraftVersion, buildId])
  @@map("software_artifacts")
}

model SoftwareBuildJob {
  id               String   @id
  provider         String
  minecraftVersion String
  buildId          String
  toolVersion      String?
  status           String   @default("queued")
  stage            String   @default("checking-prerequisites")
  bytesReceived    Int      @default(0)
  totalBytes       Int?
  percent          Float?
  pid              Int?
  workspacePath    String?
  logPath          String?
  artifactPath     String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?

  @@map("software_build_jobs")
}

model SoftwareDownload {
  id               String   @id
  provider         String
  minecraftVersion String
  buildId          String
  status           String   @default("queued")
  bytesReceived    Int      @default(0)
  totalBytes       Int?
  speedBytesPerSec Int      @default(0)
  etaSeconds       Int?
  stage            String   @default("resolving-provider")
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("software_downloads")
}

model ErrorEvent {
  id               String   @id
  category         String
  severity         String
  userMessage      String
  technicalDetails String?
  possibleSolution String?
  action           String
  source           String
  recoveriesJson   String
  createdAt        DateTime @default(now())
  clearedAt        DateTime?

  @@map("error_events")
}

model Plugin {
  id                String   @id @default(uuid())
  serverId          String
  source            String   @default("modrinth")
  contentType       String   @default("plugin")
  sourceProjectId   String?
  sourceVersionId   String?
  slug              String?
  name              String
  installedVersion  String
  fileName          String
  filePath          String
  fileHashSha1      String?
  fileHashSha512    String?
  fileSizeBytes     Int?
  enabled           Boolean  @default(true)
  status            String   @default("installed")
  updateAvailable   Boolean  @default(false)
  installedAt       DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  server            Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  dependencies      PluginDependency[]
  jobs              PluginInstallJob[]

  @@unique([serverId, source, sourceProjectId])
  @@map("plugins")
}

model PluginDependency {
  id                 String   @id @default(uuid())
  pluginId           String
  dependsOnProjectId String
  dependsOnVersionId String?
  dependsOnName      String?
  dependencyType     String
  resolvedPluginId   String?
  createdAt          DateTime @default(now())

  plugin             Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@map("plugin_dependencies")
}

model PluginInstallJob {
  id                String   @id
  serverId          String
  pluginId          String?
  projectId         String?
  versionId         String?
  action            String
  status            String   @default("queued")
  stage             String   @default("resolving-project")
  bytesReceived     Int      @default(0)
  totalBytes        Int?
  speedBytesPerSec  Int      @default(0)
  etaSeconds        Int?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  server            Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  plugin            Plugin?  @relation(fields: [pluginId], references: [id], onDelete: SetNull)

  @@map("plugin_install_jobs")
}

model ModrinthCacheEntry {
  key         String   @id
  kind        String
  payloadJson String
  cachedAt    DateTime @default(now())
  expiresAt   DateTime

  @@map("modrinth_cache_entries")
}
