// Prisma schema for ServerLab MC local app data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Server {
  id          String   @id @default(uuid())
  name        String
  path        String
  version     String
  software    String   // paper | purpur | spigot | fabric
  javaPath    String
  javaRuntimeId String?
  javaOverrideMode String @default("automatic")
  allowUnsupportedJava Boolean @default(false)
  ramMinMb    Int      @default(1024)
  ramMaxMb    Int      @default(4096)
  port        Int      @default(25565)
  startupArgs String?
  autoStart   Boolean  @default(false)
  status      String   @default("stopped") // stopped|starting|running|stopping|crashed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  backups     Backup[]
  javaRuntime JavaRuntime? @relation(fields: [javaRuntimeId], references: [id], onDelete: SetNull)

  @@map("servers")
}

model Template {
  id            String    @id @default(uuid())
  name          String
  repositoryUrl String
  version       String?
  author        String?
  official      Boolean   @default(false)
  installedAt   DateTime?

  @@map("templates")
}

model Backup {
  id        String   @id @default(uuid())
  serverId  String
  location  String
  sizeBytes Int
  type      String   @default("manual") // manual | scheduled
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("backups")
}

model JavaVersion {
  id       String  @id @default(uuid())
  major    Int
  path     String
  vendor   String? // adoptium | manual
  detected Boolean @default(true)

  @@map("java_versions")
}

model JavaRuntime {
  id                String   @id @default(uuid())
  provider          String?
  distribution      String
  major             Int
  version           String
  os                String
  arch              String
  source            String
  path              String
  executablePath    String
  status            String   @default("valid")
  checksum          String?
  detectedAt        DateTime?
  installedAt       DateTime?
  lastValidatedAt   DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers           Server[]

  @@unique([executablePath])
  @@map("java_runtimes")
}

model JavaInstallJob {
  id                String   @id
  provider          String
  major             Int
  version           String?
  status            String   @default("queued")
  stage             String   @default("resolving-provider")
  bytesReceived     Int      @default(0)
  totalBytes        Int?
  speedBytesPerSec  Int      @default(0)
  etaSeconds        Int?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("java_install_jobs")
}

model SoftwareArtifact {
  id               String   @id @default(uuid())
  provider         String
  minecraftVersion String
  buildId          String
  filename         String
  sizeBytes        Int      @default(0)
  sha256           String?
  cachedPath       String
  status           String   @default("cached")
  downloadedAt     DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, minecraftVersion, buildId])
  @@map("software_artifacts")
}

model SoftwareDownload {
  id               String   @id
  provider         String
  minecraftVersion String
  buildId          String
  status           String   @default("queued")
  bytesReceived    Int      @default(0)
  totalBytes       Int?
  speedBytesPerSec Int      @default(0)
  etaSeconds       Int?
  stage            String   @default("resolving-provider")
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("software_downloads")
}

model ErrorEvent {
  id               String   @id
  category         String
  severity         String
  userMessage      String
  technicalDetails String?
  possibleSolution String?
  action           String
  source           String
  recoveriesJson   String
  createdAt        DateTime @default(now())
  clearedAt        DateTime?

  @@map("error_events")
}
