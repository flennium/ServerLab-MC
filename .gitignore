# Dependencies
node_modules/

# Build outputs
dist/
out/
build/
stage/

# Shared package compiled output (regenerated on build)
packages/shared/src/*.js
packages/shared/src/*.js.map

# Electron packaged output
release/

# Prisma
apps/backend/prisma/dev.db
apps/backend/prisma/dev.db-journal
apps/backend/prisma/*.db
apps/backend/prisma/prisma/

# Keep migrations in git — they are the source of truth for the schema
# apps/backend/prisma/migrations/

# Runtime data directory (DB + backups — generated at runtime, never committed)
data/*.db
data/*.db-journal
data/backups/*
!data/backups/.gitkeep
data/logs/*
data/logs/
data/java-runtimes/
data/software-cache/

# Stray data dirs from old migration paths
apps/data/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/
pino-*.log

# Local planning prompts
/UI UX redesign.md
/docs/UI-UX-REDESIGN-AUDIT.md

# Backups (generated at runtime)
apps/backend/backups/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript
*.tsbuildinfo
